# Copy to .env.service (never commit secrets).
SERVICE_ORIGIN=http://127.0.0.1:5173
SERVICE_DATA_DIR=.service-data
SERVICE_COOKIE_SECURE=false
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
SERVICE_SESSION_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Google authorized redirect URI: http://127.0.0.1:5173/api/auth/callback
